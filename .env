# Scharfsinn - Konfiguration
# Diese Datei wird beim Start eingelesen. Das Admin-Passwort landet so in der DB.
# Absichtlich schwaches Passwort: steht hier, damit es per Dictionary/Brute-Force
# ratbar bleibt (siehe wordlists/demo.txt).

ADMIN_USERNAME=admin
ADMIN_PASSWORD=sommer2024

# Flags fuer CTFd. Werte hier aendern = CTFd-CSV anpassen.
FLAG_SQLI=FLAG{union_select_schmeckt_scharf}
FLAG_BAC=FLAG{kein_tuersteher_am_lager}
FLAG_CRACK=FLAG{md5_zerbroeselt_wie_chips}
FLAG_BRUTE=FLAG{sommer_war_keine_gute_idee}

# Port, auf dem der Shop laeuft (0.0.0.0 -> fuer Port-Forwarding erreichbar).
PORT=8099
